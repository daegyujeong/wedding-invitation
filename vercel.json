{
  "outputDirectory": "build/web",
  "routes": [
    {
      "src": "/invitation/(.*\\.(jpg|jpeg|png|webp|gif|svg|ico|css|js|json|txt|xml|pdf|woff|woff2|ttf|eot))",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/invitation",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=0, must-revalidate"
      }
    },
    {
      "src": "/invitation/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=0, must-revalidate"
      }
    },
    {
      "src": "/",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=0, must-revalidate"
      }
    }
  ]
}